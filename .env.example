# Kicklace — your keys are under Connections → Your website → For your developers.
# Copy this file to .env.local and fill the two keys in. The secret key is for
# your server and never goes in a page; the public key is meant to be in one.
KICKLACE_SECRET_KEY=
NEXT_PUBLIC_KICKLACE_KEY=
KICKLACE_URL=https://www.kicklace.com
NEXT_PUBLIC_KICKLACE_URL=https://www.kicklace.com

# Optional. Stripe → Developers → Webhooks, the signing secret for the endpoint
# you point at /api/webhooks/stripe. Without it that route answers with one
# sentence and verifies nothing, so it never takes an unsigned payment.
# Kicklace can also take Stripe's webhook itself, with no code at all:
# Connections → Stripe.
STRIPE_WEBHOOK_SECRET=
